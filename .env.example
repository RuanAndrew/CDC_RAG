# Modelo de embeddings: deve ser o mesmo na indexação e na recuperação.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Ollama local (opção padrão)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Ollama Cloud (API compatível com OpenAI)
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash
OLLAMA_API_KEY=

# APIs compatíveis com OpenAI (OpenAI, NVIDIA NIM, OpenRouter, vLLM etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
